{
  "packageManager": "yarn@4.3.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist/ && NODE_ENV=production webpack --mode production",
    "start": "webpack serve --mode development",
    "lint": "run-p lint:eslint lint:prettier",
    "lint:eslint": "eslint --max-warnings=0 \"**/*.{ts,tsx}\"",
    "lint:prettier": "prettier --check \"**/*.{css,js,ts,tsx,json,md}\"",
    "format": "run-s format:prettier format:eslint",
    "format:eslint": "yarn lint:eslint --fix",
    "format:prettier": "prettier --write \"**/*.{css,js,ts,tsx,json,md}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/eslint": "^8.56.10",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.5.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-import-resolver-webpack": "^0.13.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.6.0",
    "html-webpack-plugin": "^5.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^9.5.14",
    "prettier": "^3.3.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.13.1",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
